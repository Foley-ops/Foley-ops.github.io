@misc{foley2026qsv,
  title         = {{QSV}: Quat-Sphere-Vision for Coupled Quaternion Attention on Spherical Lattices},
  author        = {Foley, Nicholas and Marinelli, Devin and Moore, Donny and Enriquez, Diego and Fernandez, Amanda},
  year          = {2026},
  month         = sep,
  eprint        = {2609.30592},
  archiveprefix = {arXiv},
  primaryclass  = {cs.LG},
  abbr          = {arXiv},
  selected      = {true},
  arxiv         = {2609.30592},
  pdf           = {https://arxiv.org/pdf/2609.30592},
  tldr          = {Replaces attention's Q/K/V projections with one learned unit quaternion per token on a sparse Fibonacci-sphere graph. Ablations show the quaternion's feature transport carries the signal, while its attention routing barely matters, and parameter-matched standard-attention and 2-D baselines still come out ahead.}
